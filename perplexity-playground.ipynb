     "text": [
      "  navn  værdi\n",
      "0    A     10\n",
      "1    B     99\n",
      "2    C     99\n"
     ]
    }
   ],
   "source": [
    "for index, row in df.iterrows():\n",
    "    if row['værdi'] > 15:\n",
    "        df.at[index, 'værdi'] = 99  # Sæt ny værdi hvis betingelse er opfyldt\n",
    "\n",
    "print (df)"
   ]
  }
